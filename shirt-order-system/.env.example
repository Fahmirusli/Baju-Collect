# Neon PostgreSQL connection string (use pooled connection for Vercel)
NUXT_DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Session encryption key (min 32 characters)
NUXT_SESSION_PASSWORD=your-super-secret-session-password-min-32-chars

# Admin credentials
NUXT_ADMIN_USERNAME=admin
# Generate with: npm run admin:hash -- "yourpassword"
NUXT_ADMIN_PASSWORD_HASH=$2a$10$...

# Public site URL
NUXT_PUBLIC_SITE_URL=http://localhost:3000

